# Supabase project configuration. Never commit real credentials.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Optional client key, if used by future client-side integrations.
SUPABASE_ANON_KEY=replace-with-your-anon-key
SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key

# Optional: a strong value is recommended outside local development.
JWT_SECRET=replace-with-a-long-random-secret
